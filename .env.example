# ==============================================================================
# AssetChain Environment Configuration Template (Local Fullstack Stack)
# SAO CHÉP FILE NÀY THÀNH .env TẠI THƯ MỤC GỐC DỰ ÁN
# KHÔNG COMMIT FILE .env CHỨA PRIVATE KEY THẬT LÊN GITHUB!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SQLite + Prisma ORM)
# ------------------------------------------------------------------------------
# Đường dẫn file SQLite cục bộ (tự động tạo ra trong thư mục prisma/)
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. NEXT.JS FULLSTACK & AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Secret key mã hóa JWT session (tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=assetchain_super_secret_jwt_key_local_demo_2026_xyz123
JWT_EXPIRES_IN=7d

# Thư mục lưu trữ file tài sản cục bộ
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE_BYTES=52428800 # 50MB

# ------------------------------------------------------------------------------
# 3. BLOCKCHAIN CONFIGURATION (Hardhat Local EVM Network)
# ------------------------------------------------------------------------------
# Hardhat local node RPC endpoint
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID=31337

# Địa chỉ Smart Contract sau khi deploy trên mạng Hardhat Local
# (Thường là địa chỉ dưới đây khi deploy từ account #0)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Hardhat Account #0 (Dùng làm Admin/Deployer & Backend Signer nếu cần, CHỈ DÙNG DEMO LOCAL)
# Address: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ------------------------------------------------------------------------------
# 4. APP BASE URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
