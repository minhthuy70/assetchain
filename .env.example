# ==============================================================================
# AssetChain Environment Configuration Template
# COPY THIS FILE TO .env IN EACH SUBDIRECTORY OR AT ROOT ACCORDING TO YOUR SETUP
# DO NOT COMMIT ACTUAL PASSWORDS OR PRIVATE KEYS TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=assetchain_admin
POSTGRES_PASSWORD=assetchain_secure_password_example
POSTGRES_DB=assetchain_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ------------------------------------------------------------------------------
# 2. BACKEND CONFIGURATION (NestJS)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_change_me_in_production_min32chars
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=52428800 # 50MB

# ------------------------------------------------------------------------------
# 3. BLOCKCHAIN CONFIGURATION (EVM / Hardhat Local Network)
# ------------------------------------------------------------------------------
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Deployed contract address on local hardhat node (updated after running deploy script)
ASSET_REGISTRY_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Server wallet private key for backend sync/relayer tasks (USE ONLY LOCAL HARDHAT ACCOUNT #0 FOR DEMO)
# DEFAULT HARDHAT ACCOUNT #0 TEST KEY (NO REAL FUNDS ON MAINNET):
# 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BACKEND_OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_ASSET_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
